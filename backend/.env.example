# ---------- Servidor ----------
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---------- Base de datos ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feature_tech

# ---------- JWT ----------
# Cambie este valor por una cadena larga y aleatoria
JWT_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# ---------- Google OAuth 2.0 ----------
# Créelas en https://console.cloud.google.com/apis/credentials
# URI de redirección autorizada: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---------- Seed (administrador principal) ----------
# La contraseña se encripta con bcrypt antes de guardarse. Cámbiela después del primer inicio de sesión.
SEED_ADMIN_NAME=Robinson García
SEED_ADMIN_EMAIL=robinson.garcia@cun.edu.co
SEED_ADMIN_PASSWORD=Monark0509.
